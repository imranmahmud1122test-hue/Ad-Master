{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with credits, subscription tier, and metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "businessName": { "type": "string" },
        "businessCategory": { "type": "string" },
        "role": { "type": "string", "enum": ["USER", "ADMIN"] },
        "subscription": { "type": "string", "enum": ["FREE", "PRO", "BUSINESS"] },
        "credits": { "type": "number" },
        "onboardingCompleted": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role", "subscription", "credits"]
    },
    "Project": {
      "title": "Project",
      "description": "User created marketing asset such as a video script or campaign plan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["video", "content", "campaign", "analysis"] },
        "status": { "type": "string", "enum": ["draft", "active", "completed", "archived"] },
        "data": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "name", "type", "status", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notifications for generation completion, plan creation, and subscription limits",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "GENERATION_COMPLETE",
            "PLAN_CREATED",
            "CREDIT_LIMIT_APPROACHING",
            "PROJECT_SAVED",
            "SYSTEM_ALERT"
          ]
        },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "link": { "type": "string" },
        "actionLabel": { "type": "string" }
      },
      "required": ["userId", "type", "title", "message", "read", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Stores user projects"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Stores user notifications"
    }
  }
}
